{
  "name": "quill-monorepo",
  "version": "2.0.3",
  "description": "Quill development environment",
  "private": true,
  "author": "Jason Chen <jhchen7@gmail.com>",
  "homepage": "https://quilljs.com",
  "config": {
    "ports": {
      "quill": 9080,
      "website": 9000
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slab/quill.git"
  },
  "bugs": {
    "url": "https://github.com/slab/quill/issues"
  },
  "scripts": {
    "build": "bun run build:quill",
    "build:quill": "bun run --cwd packages/quill build",
    "build:website": "bun run --bun --cwd packages/website build",
    "start": "bun run --cwd packages/quill start",
    "start:website": "NEXT_PUBLIC_LOCAL_QUILL=true bun run --bun --cwd packages/website start",
    "lint": "bun run --cwd packages/quill lint",
    "test": "bun run --cwd packages/quill test",
    "test:unit": "bun run --cwd packages/quill test:unit",
    "test:e2e": "bun run --cwd packages/quill test:e2e",
    "test:security": "bun run --cwd packages/quill test:security",
    "verify": "bun run --cwd packages/quill verify"
  },
  "keywords": [
    "quill",
    "editor",
    "rich text",
    "wysiwyg",
    "operational transformation",
    "ot",
    "framework"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
