{
  "name": "quill",
  "version": "2.0.3",
  "description": "Your powerful, rich text editor",
  "author": "Jason Chen <jhchen7@gmail.com>",
  "homepage": "https://quilljs.com",
  "main": "quill.js",
  "type": "module",
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "parchment": "^3.0.0",
    "quill-delta": "5.1.0-internal.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/highlight.js": "^9.12.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.10.0",
    "axe-core": "4.13.0",
    "highlight.js": "^9.18.1",
    "jsdom": "^22.1.0",
    "playwright": "1.54.1",
    "svgo": "^3.2.0",
    "typescript": "^5.4.2"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slab/quill.git",
    "directory": "packages/quill"
  },
  "bugs": {
    "url": "https://github.com/slab/quill/issues"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "bun scripts/serve.ts --port 9080 --watch",
    "test": "bun run test:unit && bun run test:fuzz && bun run test:e2e",
    "test:unit": "bun scripts/test.ts unit",
    "test:unit:watch": "bun scripts/test.ts unit --watch",
    "test:fuzz": "bun scripts/test.ts fuzz",
    "test:e2e": "bun scripts/test.ts e2e",
    "test:security": "bun run test:unit core/semantic-html.spec.ts modules/syntax.spec.ts && bun run test:e2e distribution.spec.ts",
    "verify": "bun scripts/verify.ts",
    "typecheck": "bun check && bun check -p tsconfig.tools.json"
  },
  "keywords": [
    "quill",
    "editor",
    "rich text",
    "wysiwyg",
    "operational transformation",
    "ot",
    "framework"
  ],
  "engines": {
    "bun": ">=1.4.3"
  }
}
