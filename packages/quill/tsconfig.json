{
  "compilerOptions": {
    "outDir": "./dist",
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "resolveJsonModule": true,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "types": [
      "bun",
      "highlight.js"
    ],
    "skipLibCheck": true,
    "strict": false,
    "paths": {
      "quill-delta": [
        "../quill-delta/src/Delta.ts"
      ]
    },
    "rootDir": ".."
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}
