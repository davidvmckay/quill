{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".bun/declarations",
    "rootDir": ".."
  },
  "include": [
    "src/**/*.ts",
    "build.ts"
  ]
}
