{
  "compilerOptions": {
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "resolveJsonModule": true,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "types": [
      "bun",
      "highlight.js"
    ],
    "skipLibCheck": true,
    "strict": false,
    "rootDir": ".",
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
